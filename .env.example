# Supabase project URL and publishable client key; safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider is selected server-side; model names are provider-specific.
AI_PROVIDER=google
AI_MODEL=gemini-4-hydrogen
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
# To switch providers, set AI_PROVIDER=groq, choose an eligible model and set:
GROQ_API_KEY=your-groq-api-key
