# Supabase project URL and publishable client key; safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Primary provider; Google remains first unless explicitly set to groq.
AI_PROVIDER=google
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
# Optional fallback. Only configure a Groq Free account with no payment method.
# AI_PROVIDER=groq makes Groq the primary provider instead.
# AI_MODEL is accepted as a legacy GROQ_MODEL only when AI_PROVIDER=groq.
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=your-groq-api-key

# AI_PROVIDER=mock uses a deterministic offline model (tests and demos only;
# refused when VERCEL_ENV=production). AI_MOCK_LATENCY_MS simulates latency.
# AI_MOCK_LATENCY_MS=300

# Rate limits that protect the free model quotas (defaults shown).
# RATE_LIMIT_RUNS_PER_USER_HOUR=5
# RATE_LIMIT_RUNS_PER_USER_DAY=15
# RATE_LIMIT_RUNS_GLOBAL_DAY=150
# RATE_LIMIT_STEPS_PER_USER_MINUTE=10
# RATE_LIMIT_STEPS_PER_USER_DAY=200
